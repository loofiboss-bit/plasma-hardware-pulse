file(MAKE_DIRECTORY "${TEST_ROOT}")
set(CMAKE_CURRENT_SOURCE_DIR "${SERVICE_SOURCE}")
foreach(layout IN ITEMS relative absolute)
    if(layout STREQUAL "relative")
        set(CMAKE_INSTALL_PREFIX "${TEST_ROOT}/prefix with spaces")
        set(KDE_INSTALL_BINDIR "bin")
        set(KDE_INSTALL_DATADIR "share")
        set(ENV{DESTDIR} "")
        set(expected_directory "${CMAKE_INSTALL_PREFIX}/share/dbus-1/services")
        set(expected_exec "Exec=\"${CMAKE_INSTALL_PREFIX}/bin/loofi-pulse-service\"")
    else()
        set(CMAKE_INSTALL_PREFIX "/usr")
        set(KDE_INSTALL_BINDIR "/usr/bin")
        set(KDE_INSTALL_DATADIR "/usr/share")
        set(ENV{DESTDIR} "${TEST_ROOT}/absolute-stage")
        set(expected_directory "$ENV{DESTDIR}/usr/share/dbus-1/services")
        set(expected_exec "Exec=/usr/bin/loofi-pulse-service")
    endif()
    configure_file("${SERVICE_SOURCE}/install-service.cmake.in" "${TEST_ROOT}/${layout}.cmake" @ONLY)
    include("${TEST_ROOT}/${layout}.cmake")
    file(READ "${expected_directory}/com.github.loofi.hardwarepulse.Collector1.service" service)
    string(FIND "${service}" "${expected_exec}\n" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Incorrect ${layout} service activation path: ${service}")
    endif()
endforeach()
message(STATUS "Relative prefixes with spaces and Fedora absolute directories passed")
