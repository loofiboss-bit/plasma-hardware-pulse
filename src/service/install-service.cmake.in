set(PULSE_SERVICE_BINDIR "@KDE_INSTALL_BINDIR@")
set(PULSE_SERVICE_DATADIR "@KDE_INSTALL_DATADIR@")
if(NOT IS_ABSOLUTE "${PULSE_SERVICE_BINDIR}")
    set(PULSE_SERVICE_BINDIR "${CMAKE_INSTALL_PREFIX}/${PULSE_SERVICE_BINDIR}")
endif()
if(NOT IS_ABSOLUTE "${PULSE_SERVICE_DATADIR}")
    set(PULSE_SERVICE_DATADIR "${CMAKE_INSTALL_PREFIX}/${PULSE_SERVICE_DATADIR}")
endif()
set(PULSE_SERVICE_EXEC "${PULSE_SERVICE_BINDIR}/loofi-pulse-service")
if(PULSE_SERVICE_EXEC MATCHES " ")
    set(PULSE_SERVICE_EXEC "\"${PULSE_SERVICE_EXEC}\"")
endif()
set(PULSE_SERVICE_DEST "$ENV{DESTDIR}${PULSE_SERVICE_DATADIR}/dbus-1/services")
file(MAKE_DIRECTORY "${PULSE_SERVICE_DEST}")
configure_file("@CMAKE_CURRENT_SOURCE_DIR@/com.github.loofi.hardwarepulse.Collector1.service.in"
    "${PULSE_SERVICE_DEST}/com.github.loofi.hardwarepulse.Collector1.service" @ONLY)
